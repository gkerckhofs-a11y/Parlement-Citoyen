{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": "public",
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/carte/**",
        "destination": "/card.html"
      },
      {
        "source": "/projection/**",
        "destination": "/projection.html"
      },
      {
        "source": "/api/**",
        "function": {
          "functionId": "parliament",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
